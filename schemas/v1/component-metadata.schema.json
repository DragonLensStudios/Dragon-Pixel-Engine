{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dragonpixel.dev/schemas/v1/component-metadata.schema.json",
  "title": "Dragon Pixel Engine component metadata manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "components"],
  "properties": {
    "format": { "const": "dpe.component-metadata" },
    "formatVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeId", "displayName", "schemaVersion", "owner", "properties"],
      "properties": {
        "typeId": { "$ref": "#/$defs/stableId" },
        "displayName": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "owner": { "enum": ["native", "managed"] },
        "properties": {
          "type": "array",
          "items": { "$ref": "#/$defs/property" }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["propertyId", "displayName", "valueType", "order", "readOnly"],
      "properties": {
        "propertyId": { "$ref": "#/$defs/stableId" },
        "displayName": { "type": "string", "minLength": 1 },
        "valueType": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "string",
            "vector2",
            "vector3",
            "quaternion",
            "color",
            "entity-reference",
            "asset-reference"
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "readOnly": { "type": "boolean" }
      }
    }
  }
}

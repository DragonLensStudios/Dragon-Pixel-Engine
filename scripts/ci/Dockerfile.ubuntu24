FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG DOTNET_SDK_VERSION=10.0.203
ARG QT_VERSION=6.11.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        libclang-rt-18-dev \
        libasound2t64 \
        libdbus-1-3 \
        libegl1 \
        libfontconfig1 \
        libfreetype6 \
        libgl1 \
        libglib2.0-0t64 \
        libgl1-mesa-dev \
        libgl1-mesa-dri \
        libopenal1 \
        libsdl2-2.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb-cursor0 \
        libxcb-glx0 \
        libxcb-icccm4 \
        libxcb-image0 \
        libxcb-keysyms1 \
        libxcb-randr0 \
        libxcb-render-util0 \
        libxcb-shape0 \
        libxcb-shm0 \
        libxcb-sync1 \
        libxcb-xfixes0 \
        libxcb-xkb1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxkbcommon-x11-0 \
        libxrender1 \
        ninja-build \
        nlohmann-json3-dev \
        p7zip-full \
        python3 \
        python3-pip \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --no-cache-dir aqtinstall==3.3.0 \
    && aqt install-qt linux desktop "${QT_VERSION}" linux_gcc_64 -O /opt/Qt

RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --version "${DOTNET_SDK_VERSION}" --install-dir /opt/dotnet \
    && rm /tmp/dotnet-install.sh

ENV PATH="/opt/dotnet:${PATH}"
ENV QT_ROOT_DIR="/opt/Qt/6.11.1/gcc_64"
ENV CMAKE_PREFIX_PATH="/opt/Qt/6.11.1/gcc_64"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_CLI_USE_MSBUILD_SERVER=0
ENV DOTNET_NOLOGO=1
ENV MSBUILDDISABLENODEREUSE=1

WORKDIR /workspace

COPY . /workspace
